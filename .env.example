# Google OAuth Web application credentials (keep real values private)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SESSION_SECRET=

# Email verification and password reset codes (SendGrid Single Sender)
SENDGRID_API_KEY=
# Use the exact email address verified in SendGrid, e.g. you@example.com
AUTH_FROM_EMAIL=

# Optional legacy provider (used only when SENDGRID_API_KEY is not set)
RESEND_API_KEY=

# Optional YouTube song search
YOUTUBE_API_KEY=
